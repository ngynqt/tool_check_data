# Facebook credentials
FB_EMAIL=your_email@gmail.com
FB_PASSWORD=your_password

# Greeting message sent to each profile
GREETING_MESSAGE=Xin chào! Mình muốn kết nối với bạn.

# Browser mode: true = hidden, false = visible (useful for debugging)
HEADLESS_MODE=true

# Human-like delay range (seconds) between actions
MIN_DELAY=3
MAX_DELAY=7
